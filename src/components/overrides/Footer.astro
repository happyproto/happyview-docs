---
// Starlight's footer, then the links and copyright every other page ends on.
import Default from '@astrojs/starlight/components/Footer.astro';
import { footer } from '../../site';
---

<Default />
<p class="term-status" role="status" aria-live="polite" data-term-status></p>
<div class="site-foot not-content print:hidden">
  <p>{footer.copyright}</p>
  <ul role="list">
    {footer.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
  </ul>
</div>

<script>
  // A terminal's Copy button copies its commands, without the "$" or the
  // comments. It is hidden until this runs, since without it the button
  // would do nothing.
  const status = document.querySelector<HTMLElement>('[data-term-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>('.hp-term-copy[data-copy]')) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.textContent = 'Copied';
        if (status) status.textContent = 'Copied the commands';
      } catch {
        button.textContent = 'Copy failed';
      }
      setTimeout(() => {
        button.textContent = 'Copy';
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .site-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--hp-space-2) var(--hp-space-4);
    margin-block-start: var(--hp-space-8);
    padding-block-start: var(--hp-space-4);
    color: var(--hp-color-fg-muted);
    font-size: var(--hp-text-sm);
  }
  .site-foot p,
  .site-foot ul {
    margin: 0;
    padding: 0;
  }
  .site-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--hp-space-4);
    list-style: none;
  }
  .site-foot a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    color: inherit;
  }
  .site-foot a:hover {
    color: var(--hp-color-fg);
  }
</style>
